# ─── Inference / model weights ───────────────────────────────────────────
# Required only if you want to fetch models from Hugging Face at runtime.
# The default Gemma4 and Nemotron weights can be pre-placed under ./models/
# to avoid needing a token at all.
HUGGING_FACE_HUB_TOKEN=hf_your_token_here
NGC_API_KEY=nvapi-your_key_here

# ─── Slack channel (templated into .zeroclaw/config.toml) ────────────────
# Only required if you keep `[channels.slack] enabled = true` in the
# zeroclaw config template. Use the Socket Mode tokens from your Slack app.
SLACK_APP_TOKEN=xapp-your_socket_mode_app_token
SLACK_BOT_TOKEN=xoxb-your_bot_token

# ─── Web search (templated into .zeroclaw/config.toml) ───────────────────
# Only required if you keep `[web_search] enabled = true`. Brave is the
# default provider; swap the config to SearXNG if you'd rather self-host.
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# --- Multi-Agent Configuration ---
# Operator Agent Tokens
SLACK_OPERATOR_APP_TOKEN=xapp-...
SLACK_OPERATOR_BOT_TOKEN=xoxb-...
# Comma-separated list of Slack IDs: "U123","U456"
SLACK_ALLOWED_OPERATOR_USERS="*"

# Admin Agent Tokens
SLACK_ADMIN_APP_TOKEN=xapp-...
SLACK_ADMIN_BOT_TOKEN=xoxb-...
# Comma-separated list of Slack IDs: "U123","U456"
SLACK_ALLOWED_ADMIN_USERS="*"
