# Custom parent-level Dockerfile for ZeroClaw with Python 3 support on Ubuntu 24.04
FROM ubuntu:24.04

# Basic runtime dependencies including python3 and adduser for skill execution
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        python3 \
        adduser \
    && rm -rf /var/lib/apt/lists/*

# Copy the locally compiled artifacts
COPY target/release-fast/zeroclaw /usr/local/bin/zeroclaw
COPY web/dist /zeroclaw-data/web/dist

ENV ZEROCLAW_WORKSPACE=/zeroclaw-data/workspace
ENV HOME=/zeroclaw-data

# Run as the host account that owns the bind-mounted state directories, so the
# agents never need root. The Jetson account is 'uplift' (UID/GID 2002) since the
# September 2026 reflash; override with --build-arg on a host that differs.
# /zeroclaw-data is chowned because zeroclaw_entrypoint.sh patches the web
# bundle in place at startup.
ARG UID=2002
ARG GID=2002
RUN userdel ubuntu \
    && addgroup --gid ${GID} uplift \
    && adduser --disabled-password --gecos "" --uid ${UID} --gid ${GID} \
         --home /zeroclaw-data --no-create-home uplift \
    && chown -R ${UID}:${GID} /zeroclaw-data
USER ${UID}:${GID}

WORKDIR /zeroclaw-data
EXPOSE 42617
ENTRYPOINT ["zeroclaw"]
CMD ["daemon"]
